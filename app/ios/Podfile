# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase: resolve the Firebase SDK through CocoaPods (not SPM)
# and link it statically, which requires static frameworks.
$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'LiveOL' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 only supports deployment targets >= 15.0.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        if build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # fmt: consteval format strings fail to compile with Xcode 27 clang.
    patch_pod_file(installer, 'fmt/include/fmt/base.h',
      "#if !defined(__cpp_lib_is_constant_evaluated)\n",
      "#if 1  // Patched in Podfile: consteval broken with Xcode 27 clang\n#  define FMT_USE_CONSTEVAL 0\n#elif !defined(__cpp_lib_is_constant_evaluated)\n")

    # RevenueCat: Xcode 27 synthesizes a memberwise init(stringRepresentation:)
    # that clashes with the public throwing one. Declaring any init in the
    # struct body suppresses the synthesized one.
    patch_pod_file(installer, 'RevenueCat/Sources/Paywalls/PaywallColor.swift',
      "    fileprivate var _underlyingColor: (any Sendable)?\n",
      "    fileprivate var _underlyingColor: (any Sendable)?\n\n    // Patched in Podfile: suppress memberwise init (Xcode 27)\n    private init(_suppressMemberwise: Never) { switch _suppressMemberwise {} }\n")
  end
end

def patch_pod_file(installer, relative_path, find, replace)
  path = File.join(installer.sandbox.root, relative_path)
  return unless File.exist?(path)
  contents = File.read(path)
  return if contents.include?(replace)
  unless contents.include?(find)
    Pod::UI.warn "patch_pod_file: pattern not found in #{relative_path}, skipping"
    return
  end
  File.chmod(0644, path)
  File.write(path, contents.sub(find, replace))
end